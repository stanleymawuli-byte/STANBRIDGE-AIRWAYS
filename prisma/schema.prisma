generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum UserRole {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  BOOKING_AGENT
  FINANCE_OFFICER
  CUSTOMER
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PassengerType {
  ADULT
  CHILD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

enum AmadeusOrderStatus {
  NOT_CREATED
  PROCESSING
  CREATED
  FAILED
  CANCELLED
}

model User {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  emailVerified    Boolean    @default(false)
  image            String?
  role             UserRole   @default(CUSTOMER)
  twoFactorEnabled Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactor        TwoFactor?
  bookings         Booking[]
  auditLogs        AuditLog[]
  configurationSnapshots ConfigurationSnapshot[]
  backupsCreated   BackupRecord[]
  settingsUpdated  SystemSetting[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                   String    @id @default(cuid())
  accountId            String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model TwoFactor {
  id                      String   @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String   @unique
  verified                Boolean  @default(true)
  failedVerificationCount Int      @default(0)
  lockedUntil             DateTime?
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model Booking {
  id              String          @id @default(cuid())
  reference       String          @unique
  status          BookingStatus   @default(PENDING_PAYMENT)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin          String
  destination     String
  departureDate   DateTime
  returnDate      DateTime?
  cabin           String
  airline         String?
  fareCurrency    String
  fareAmount      Decimal         @db.Decimal(12, 2)
  amadeusOfferId  String
  amadeusOfferData Json?
  amadeusOrderStatus AmadeusOrderStatus @default(NOT_CREATED)
  amadeusOrderId String?          @unique
  amadeusRecordLocator String?
  amadeusOrderError String?
  amadeusCreatedAt DateTime?
  expiresAt       DateTime
  passengers      Passenger[]
  ticket          Ticket?
  payments        Payment[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model Passenger {
  id          String        @id @default(cuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type        PassengerType @default(ADULT)
  title       String
  firstName   String
  lastName    String
  dateOfBirth DateTime
  email       String?
  phone       String?
  passportNumber String?
  nationality String?
  gender      String        @default("UNSPECIFIED")

  @@index([bookingId])
}

model Ticket {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketNumber  String   @unique
  status        String   @default("ISSUED")
  issuedAt      DateTime @default(now())

  @@index([ticketNumber])
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reference       String        @unique
  status          PaymentStatus @default(PENDING)
  provider        String        @default("PAYSTACK")
  currency        String
  amount          Decimal       @db.Decimal(12, 2)
  amountMinor     Int
  authorizationUrl String?
  accessCode      String?
  providerResponse String?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
}

 
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

model ConfigurationSnapshot {
  id          String   @id @default(cuid())
  name        String
  settings    Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([createdById, createdAt])
}

model BackupRecord {
  id          String   @id @default(cuid())
  filename    String
  storageKey  String
  storageType String   @default("LOCAL")
  status      String   @default("COMPLETED")
  sizeBytes   BigInt
  sha256      String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

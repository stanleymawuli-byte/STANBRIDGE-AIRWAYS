# Copy to .env.local and set every required secret there.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/stanbridge_airways?schema=public
BETTER_AUTH_SECRET=
PASSWORD_PEPPER=

# Resend email delivery for verification and password recovery.
RESEND_API_KEY=
EMAIL_FROM=StanBridge Airways <accounts@example.com>

# Amadeus provider credentials.
AMADEUS_ENV=test
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

PAYSTACK_ENV=test
# Sandbox keys start with sk_test_. Never use a live secret key.
PAYSTACK_SECRET_KEY=
# Keep this aligned with the fare currency until a currency conversion layer exists.
PAYSTACK_CURRENCY=GHS

# Optional local-only demo accounts. Use separate, strong passwords and never commit them.
DEMO_SUPER_ADMIN_EMAIL=admin@example.test
DEMO_SUPER_ADMIN_PASSWORD=
DEMO_OPERATIONS_MANAGER_EMAIL=operations@example.test
DEMO_OPERATIONS_MANAGER_PASSWORD=
DEMO_BOOKING_AGENT_EMAIL=agent@example.test
DEMO_BOOKING_AGENT_PASSWORD=
DEMO_FINANCE_OFFICER_EMAIL=finance@example.test
DEMO_FINANCE_OFFICER_PASSWORD=

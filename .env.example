# Copy to .env.local and set every required secret there.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/stanbridge_airways?schema=public
BETTER_AUTH_SECRET=
PASSWORD_PEPPER=

# Resend email delivery for verification and password recovery.
RESEND_API_KEY=
EMAIL_FROM=StanBridge Airways <accounts@example.com>

# Amadeus provider credentials.
AMADEUS_ENV=test
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

PAYSTACK_ENV=test
# Sandbox keys start with sk_test_. Never use a live secret key.
PAYSTACK_SECRET_KEY=
# Keep this aligned with the fare currency until a currency conversion layer exists.
PAYSTACK_CURRENCY=GHS

# SMS notifications for flight booking confirmations (Twilio or Termii)
# Option A: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option B: Termii
# TERMII_API_KEY=
# TERMII_SENDER_ID=StanBridge

# Four local demo accounts only. Set four distinct strong passwords before npm run db:seed.
DEMO_SUPER_ADMIN_EMAIL=demo.superadmin@stanbridge.local
DEMO_SUPER_ADMIN_PASSWORD=
DEMO_OPERATIONS_EMAIL=demo.operations@stanbridge.local
DEMO_OPERATIONS_PASSWORD=
DEMO_BOOKING_EMAIL=demo.booking@stanbridge.local
DEMO_BOOKING_PASSWORD=
DEMO_FINANCE_EMAIL=demo.finance@stanbridge.local
DEMO_FINANCE_PASSWORD=

# Private durable backup storage. Configure in the hosting provider's secret settings.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Local persistent storage fallback and pg_dump path (production host must provide pg_dump).
BACKUP_DIRECTORY=
PG_DUMP_PATH=
# Random 32+ character secret for the scheduled backup endpoint.
CRON_SECRET=

# Optional one-time password hash demonstration input; do not reuse a real account password.
DEMO_HASH_PASSWORD=
